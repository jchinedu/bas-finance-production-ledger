# Database connection string
# Port 5433 is mapped in docker-compose.yml to avoid conflicts with native PostgreSQL
DATABASE_URL=postgres://ledger:ledger@localhost:5433/production_ledger

# Fastify server port
PORT=3000

# Environment mode (development | test | production)
NODE_ENV=development

# API Security Credentials (REQUIRED in production)
API_KEY=test-api-key
ADMIN_API_KEY=admin-secret-key
