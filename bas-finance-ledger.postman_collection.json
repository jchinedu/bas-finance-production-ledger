{
  "info": {
    "name": "BAS Finance - Production Ledger Engine",
    "description": "Postman Collection for BAS Finance Lending Ledger API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "test-api-key",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Term Loans",
      "item": [
        {
          "name": "Create Term Loan (Worked Example 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"principalKobo\": \"120000000\",\n  \"annualRateBps\": 1800,\n  \"termMonths\": 6,\n  \"disbursementDate\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans/term",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "term"]
            }
          }
        },
        {
          "name": "Get Loan Repayment Schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/loans/1/schedule",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "1", "schedule"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Accrual Job",
      "item": [
        {
          "name": "Run Interest Accrual (Period 1 Due Date)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asOfDate\": \"2026-02-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/accrual/run",
              "host": ["{{baseUrl}}"],
              "path": ["accrual", "run"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Payments & Idempotency",
      "item": [
        {
          "name": "Post Payment (Clearing Instalment 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "pay-worked-example-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loanId\": \"1\",\n  \"amountKobo\": \"21063026\",\n  \"paymentDate\": \"2026-02-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "Get Payment Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/1",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "1"]
            }
          }
        },
        {
          "name": "Reverse Payment (Task 4)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reversalDate\": \"2026-02-05\",\n  \"reason\": \"Bounced cheque\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/1/reverse",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "1", "reverse"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Invoice Financing (Product A)",
      "item": [
        {
          "name": "Create Invoice Financing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"faceValueKobo\": \"1000000000\",\n  \"annualRateBps\": 3600,\n  \"dueDate\": \"2026-03-02\",\n  \"disbursementDate\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "invoice"]
            }
          }
        },
        {
          "name": "Settle Invoice (10 Days Overdue with Penalty)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settlementDate\": \"2026-03-12\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/loans/invoice/1/settle",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "invoice", "1", "settle"]
            }
          }
        }
      ]
    },
    {
      "name": "5. General Ledger & Reconciliation",
      "item": [
        {
          "name": "Get Trial Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/trial-balance",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "trial-balance"]
            }
          }
        },
        {
          "name": "Get Journal Entries for Loan",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ledger/entries/1",
              "host": ["{{baseUrl}}"],
              "path": ["ledger", "entries", "1"]
            }
          }
        },
        {
          "name": "Run Reconciliation Audit (Task 5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/periods/reconcile",
              "host": ["{{baseUrl}}"],
              "path": ["periods", "reconcile"]
            }
          }
        },
        {
          "name": "Close Accounting Period (January 2026)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/periods/2026/1/close",
              "host": ["{{baseUrl}}"],
              "path": ["periods", "2026", "1", "close"]
            }
          }
        }
      ]
    }
  ]
}
